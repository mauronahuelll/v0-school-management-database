rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserSchoolRole(schoolId) {
      let userData = getUserData();
      return userData.schoolRoles[schoolId];
    }

    function hasSchoolAccess(schoolId) {
      return isAuthenticated() && 
        getUserSchoolRole(schoolId) != null &&
        getUserSchoolRole(schoolId).status == 'ACTIVE';
    }

    function hasRole(schoolId, allowedRoles) {
      return hasSchoolAccess(schoolId) && 
        getUserSchoolRole(schoolId).role in allowedRoles;
    }

    function isSchoolAdmin(schoolId) {
      return hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN']);
    }

    function isSchoolStaff(schoolId) {
      return hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'PRECEPTOR', 'TEACHER']);
    }

    function isTutor(schoolId) {
      return hasRole(schoolId, ['TUTOR']);
    }

    // ============================================
    // SCHOOLS COLLECTION
    // ============================================

    match /schools/{schoolId} {
      allow read: if hasSchoolAccess(schoolId);
      allow create: if false; // Schools are created via admin SDK only
      allow update: if isSchoolAdmin(schoolId);
      allow delete: if false; // Schools cannot be deleted via client

      // ============================================
      // STUDENTS SUBCOLLECTION
      // ============================================
      match /students/{studentId} {
        allow read: if hasSchoolAccess(schoolId);
        allow create: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'PRECEPTOR']);
        allow update: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'PRECEPTOR']);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // ============================================
      // COURSES SUBCOLLECTION
      // ============================================
      match /courses/{courseId} {
        allow read: if hasSchoolAccess(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // ============================================
      // ATTENDANCE SUBCOLLECTION
      // ============================================
      match /attendance/{attendanceId} {
        allow read: if hasSchoolAccess(schoolId);
        allow create: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'PRECEPTOR']);
        allow update: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'PRECEPTOR']);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // ============================================
      // GRADES SUBCOLLECTION
      // ============================================
      match /grades/{gradeId} {
        // Teachers can read their own grades, tutors only published ones
        allow read: if hasSchoolAccess(schoolId) && (
          isSchoolStaff(schoolId) ||
          (isTutor(schoolId) && resource.data.isPublished == true)
        );
        allow create: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'TEACHER']);
        allow update: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'TEACHER']);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // ============================================
      // BEHAVIOR SUBCOLLECTION
      // ============================================
      match /behavior/{behaviorId} {
        // Helper: Check if content is locked (already signed)
        function isContentLocked() {
          return resource.data.contentLocked == true;
        }
        
        // Helper: Check if tutor is only modifying acknowledgment
        function isTutorAcknowledgmentOnly() {
          let allowedFields = ['sanction', 'updatedAt'];
          let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
          return changedKeys.hasOnly(allowedFields);
        }
        
        // Helper: Validate acknowledgment changes (tutor can only set specific fields)
        function isValidAcknowledgmentChange() {
          let beforeAck = resource.data.sanction.acknowledgment;
          let afterAck = request.resource.data.sanction.acknowledgment;
          
          // Status must be changing from PENDING
          return beforeAck.status == 'PENDING' &&
            (afterAck.status == 'ACKNOWLEDGED' || afterAck.status == 'DISPUTED') &&
            // Cannot modify the document hash
            afterAck.documentHash == beforeAck.documentHash &&
            // Cannot modify hash generation time
            afterAck.hashGeneratedAt == beforeAck.hashGeneratedAt;
        }
        
        // Helper: Prevent modification of protected fields when locked
        function areProtectedFieldsUnchanged() {
          let before = resource.data;
          let after = request.resource.data;
          return before.description == after.description &&
            before.category == after.category &&
            before.date == after.date &&
            before.sanction.severity == after.sanction.severity &&
            before.sanction.sanctionTypeId == after.sanction.sanctionTypeId;
        }
        
        // READ: Staff sees all, tutors only see visible records
        allow read: if hasSchoolAccess(schoolId) && (
          isSchoolStaff(schoolId) ||
          (isTutor(schoolId) && resource.data.visibleToTutor == true)
        );
        
        // CREATE: Only staff can create behavior records
        allow create: if hasRole(schoolId, ['SUPER_ADMIN', 'ADMIN', 'PRECEPTOR', 'TEACHER']);
        
        // UPDATE: Complex rules based on role and lock status
        allow update: if hasSchoolAccess(schoolId) && (
          // CASE 1: Staff can update if content is not locked
          (isSchoolStaff(schoolId) && !isContentLocked()) ||
          
          // CASE 2: Staff can update non-protected fields even when locked
          (isSchoolStaff(schoolId) && isContentLocked() && areProtectedFieldsUnchanged()) ||
          
          // CASE 3: Tutor can ONLY update acknowledgment fields
          (isTutor(schoolId) && 
           isTutorAcknowledgmentOnly() &&
           isValidAcknowledgmentChange())
        );
        
        // DELETE: Only admins, and only if not locked
        allow delete: if isSchoolAdmin(schoolId) && !isContentLocked();
      }

      // ============================================
      // TUTOR RELATIONS SUBCOLLECTION
      // ============================================
      match /tutorRelations/{relationId} {
        allow read: if hasSchoolAccess(schoolId);
        allow create: if isSchoolAdmin(schoolId);
        allow update: if isSchoolAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // ============================================
      // NOTIFICATIONS SUBCOLLECTION
      // ============================================
      match /notifications/{notificationId} {
        // Users can only read their own notifications
        allow read: if hasSchoolAccess(schoolId) && 
          resource.data.recipientId == request.auth.uid;
        allow create: if false; // Created by Cloud Functions only
        // Users can mark their notifications as read
        allow update: if hasSchoolAccess(schoolId) && 
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['channels']);
        allow delete: if false;
      }

      // ============================================
      // ANNOUNCEMENTS SUBCOLLECTION
      // ============================================
      match /announcements/{announcementId} {
        allow read: if hasSchoolAccess(schoolId) && (
          isSchoolStaff(schoolId) ||
          resource.data.status == 'PUBLISHED'
        );
        allow create: if isSchoolAdmin(schoolId);
        allow update: if isSchoolAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }
    }

    // ============================================
    // USERS COLLECTION (Root level)
    // ============================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can update their own profile (limited fields)
      allow update: if isAuthenticated() && request.auth.uid == userId;
      // Users cannot delete themselves
      allow delete: if false;
      // Account creation handled by Cloud Functions on auth trigger
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // SYSTEM COLLECTIONS (Cloud Functions only)
    // ============================================
    
    // Idempotency tracking
    match /_processedEvents/{eventId} {
      allow read, write: if false; // Cloud Functions only via Admin SDK
    }
    
    // Digital signature audit log
    match /_signatureAuditLog/{logId} {
      allow read, write: if false; // Cloud Functions only - legal records
    }
    
    // Integrity violation tracking
    match /_integrityViolations/{violationId} {
      allow read, write: if false; // Cloud Functions only - security records
    }
  }
}
